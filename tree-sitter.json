{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "mojo",
      "camelcase": "Mojo",
      "title": "Mojo",
      "scope": "source.mojo",
      "file-types": ["mojo"],
      "injection-regex": "^mojo$",
      "class-name": "TreeSitterMojo"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Mojo tree-sitter grammar",
    "authors": [
      {
        "name": "Nathan Ward",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-mojo",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
